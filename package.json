{
  "name": "upload-action",
  "version": "0.0.0",
  "private": true,
  "description": "Generic GitHub Action that uploads an OpenAPI description to the Specdocular platform.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:test": "tsc -p tsconfig.json",
    "test": "npm run build:test && node --test \"build/**/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "ncc build src/index.ts -o dist --source-map",
    "all": "npm run typecheck && npm run test && npm run package"
  },
  "dependencies": {
    "@actions/core": "^1.11.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.7.0"
  }
}
